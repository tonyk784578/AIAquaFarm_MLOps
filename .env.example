# ============================================================
# AIAquafarm Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
DEBUG=false
LOG_LEVEL=info
SECRET_KEY=change_me_to_a_random_secret_key_at_least_32_chars

# --- PostgreSQL + TimescaleDB ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aquafarm
POSTGRES_USER=aquafarm
POSTGRES_PASSWORD=aquafarm_secret
DATABASE_URL=postgresql+asyncpg://aquafarm:aquafarm_secret@postgres:5432/aquafarm

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://aquafarm:aquafarm_secret@postgres:5432/aquafarm_mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# --- AI / LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Backend Service URLs ---
BACKEND_URL=http://backend:8000
AGENTS_URL=http://agents:8001

# --- Edge Devices ---
CAMERA_STREAM_URL=rtsp://edge-camera:554/stream
SENSOR_POLL_INTERVAL=5

# --- Alert Thresholds ---
AMMONIA_THRESHOLD_PPM=0.5
NITRITE_THRESHOLD_PPM=0.1
DISSOLVED_OXYGEN_MIN_MGL=6.0
PH_MIN=6.5
PH_MAX=8.5
TEMPERATURE_MIN_C=18.0
TEMPERATURE_MAX_C=28.0

# --- Storage (for Data Lake) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aquafarm-datalake

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
