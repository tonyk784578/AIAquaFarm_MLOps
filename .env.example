# ============================================================
# AIAquafarm Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
DEBUG=false
LOG_LEVEL=info
SECRET_KEY=change_me_to_a_random_secret_key_at_least_32_chars

# --- JWT / Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_REFRESH_SECRET_KEY=change_me_to_a_different_secret_for_refresh_tokens
REGISTRATION_OPEN=false

# --- Cookie settings (set COOKIE_SECURE=true in HTTPS production) ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Internal service-to-service API key (agents → backend) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=change_me_to_a_random_internal_api_key
BACKEND_API_KEY=change_me_to_a_random_internal_api_key

# --- PostgreSQL + TimescaleDB ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aquafarm
POSTGRES_USER=aquafarm
POSTGRES_PASSWORD=aquafarm_secret
DATABASE_URL=postgresql+asyncpg://aquafarm:aquafarm_secret@postgres:5432/aquafarm

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://aquafarm:aquafarm_secret@postgres:5432/aquafarm_mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# --- AI / LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
# In production (via Nginx), set this to empty or the /agents path prefix
VITE_AGENT_BASE_URL=http://localhost:8001

# --- Backend Service URLs ---
BACKEND_URL=http://backend:8000
AGENTS_URL=http://agents:8001

# --- Tanks ---
DEFAULT_TANK_IDS=["TANK-01","TANK-02","TANK-03"]

# --- Edge Devices ---
CAMERA_STREAM_URL=rtsp://edge-camera:554/stream
SENSOR_POLL_INTERVAL=5

# --- Alert Thresholds ---
AMMONIA_THRESHOLD_PPM=0.5
NITRITE_THRESHOLD_PPM=0.1
DISSOLVED_OXYGEN_MIN_MGL=6.0
PH_MIN=6.5
PH_MAX=8.5
TEMPERATURE_MIN_C=18.0
TEMPERATURE_MAX_C=28.0

# --- Storage (for Data Lake) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aquafarm-datalake

# --- Observability ---
# Prometheus metrics ship out of /metrics on each FastAPI service by default.
# Disable per-service by setting OBSERVABILITY_METRICS_ENABLED=false.
OBSERVABILITY_METRICS_ENABLED=true
# OpenTelemetry tracing — leave empty to disable. Common values:
#   http://otel-collector:4317   (compose / k8s)
#   http://localhost:4317        (host-mode collector)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
DEPLOY_ENV=dev
SERVICE_VERSION=0.1.0

# --- MLOps service ---
# URL of the MLOps FastAPI (the backend proxies /api/v1/mlops/* to this).
MLOPS_API_URL=http://mlops_api:8002
# Cadence for AutoML check-and-retrain and lightweight drift cycles (minutes).
MLOPS_AUTOML_INTERVAL_MIN=60
MLOPS_DRIFT_INTERVAL_MIN=15
# True = run drift/sample counts but skip actual training subprocesses.
MLOPS_DRY_RUN=true
# Drift detection CSV pairs (optional — leave unset to skip)
# MLOPS_WQ_REF_CSV=/data/wq_train.csv
# MLOPS_WQ_CUR_CSV=/data/wq_live.csv
# Training data paths (consumed by the scheduler when retraining is triggered)
# MLOPS_WQ_TRAIN_CSV=/data/wq_train.csv
# MLOPS_FEEDING_TRAIN_DIR=/data/feeding_dataset
# MLOPS_GROWTH_TRAIN_YAML=/data/growth/data.yaml
# Edge deployment (optional)
# MLOPS_EDGE_HOST=192.168.1.100
# MLOPS_EDGE_USER=aquafarm
# MLOPS_EDGE_SSH_KEY=/root/.ssh/edge_key

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
