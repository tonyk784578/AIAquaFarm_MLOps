FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

# OpenCV dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    opencv-python-headless>=4.10.0 \
    httpx>=0.27.0 \
    structlog>=24.2.0 \
    pydantic-settings>=2.3.0

COPY . .

# Edge device runs both camera stream and sensor reader
CMD ["python", "-c", "import asyncio; from camera.stream import run_camera; from sensor.reader import run_sensor; asyncio.run(run_camera())"]
